# Optional: blank generates and persists a device ID for password login
BAFANG_DEVICE_ID=
APP_TIMEZONE=Europe/Zurich
# Host UID/GID matching ownership of data/ and login secret files
LOCAL_UID=1000
LOCAL_GID=1000
SYNC_INTERVAL_SECONDS=1800
HTTP_TIMEOUT_SECONDS=30
SYNC_MAX_PAGES=1000
BAFANG_PAGE_SIZE=20
RETRY_ATTEMPTS=4
RETRY_BASE_SECONDS=2
RETRY_CAP_SECONDS=60
HEALTH_STALE_SECONDS=3900

# Enable only after the TCX import test
ENDURAIN_ENABLED=false
ENDURAIN_URL=http://your-private-endurain-host:8080
